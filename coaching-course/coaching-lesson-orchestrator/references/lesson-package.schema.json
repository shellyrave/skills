{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coaching lesson package 1.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "lesson_id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "autonomous",
        "collaborative"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "full_lesson",
            "chapter"
          ]
        },
        "chapter_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "kind",
        "chapter_ids"
      ],
      "additionalProperties": false
    },
    "brief": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "focus": {
          "type": "string",
          "minLength": 1
        },
        "learning_outcomes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preserve": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "title",
        "audience",
        "focus",
        "learning_outcomes",
        "include",
        "exclude",
        "preserve"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "google_doc",
              "google_slides",
              "pdf",
              "docx",
              "pptx",
              "image",
              "text",
              "other"
            ]
          },
          "role": {
            "enum": [
              "lesson_content",
              "method",
              "visual_reference",
              "brand",
              "example"
            ]
          },
          "status": {
            "enum": [
              "available",
              "missing",
              "inaccessible"
            ]
          },
          "read": {
            "type": "boolean"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "location",
          "kind",
          "role",
          "status",
          "read",
          "version",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "blocking_stages": {
            "type": "array",
            "items": {
              "enum": [
                "intake",
                "structure",
                "content",
                "facilitation",
                "presentation",
                "review"
              ]
            }
          },
          "blocking_slide_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "open",
              "answered"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "question",
          "reason",
          "blocking_stages",
          "blocking_slide_ids",
          "status",
          "answer"
        ],
        "additionalProperties": false
      }
    },
    "duration": {
      "type": "object",
      "properties": {
        "target_minutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "estimated": {
          "type": "boolean"
        }
      },
      "required": [
        "target_minutes",
        "estimated"
      ],
      "additionalProperties": false
    },
    "explicit_slide_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "outcome"
        ],
        "additionalProperties": false
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "chapter_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "points": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "activity": {
            "type": [
              "string",
              "null"
            ]
          },
          "speaker_notes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "visuals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "asset_path": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "kind": {
                  "enum": [
                    "photo",
                    "diagram",
                    "brand",
                    "map",
                    "model"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "status": {
                  "enum": [
                    "available",
                    "missing",
                    "planned"
                  ]
                },
                "alt": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "source_id",
                "asset_path",
                "kind",
                "required",
                "status",
                "alt"
              ],
              "additionalProperties": false
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "duration_minutes": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "approved_fields": {
            "type": "array",
            "items": {
              "enum": [
                "title",
                "points",
                "questions",
                "activity",
                "speaker_notes",
                "visuals",
                "source_ids",
                "duration_minutes"
              ]
            }
          },
          "content_version": {
            "type": "integer",
            "minimum": 1
          },
          "rendered_content_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        },
        "required": [
          "id",
          "chapter_id",
          "title",
          "points",
          "questions",
          "activity",
          "speaker_notes",
          "visuals",
          "source_ids",
          "duration_minutes",
          "approved_fields",
          "content_version",
          "rendered_content_version"
        ],
        "additionalProperties": false
      }
    },
    "stages": {
      "type": "object",
      "properties": {
        "intake": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "needs_input",
                "stale"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "notes"
          ],
          "additionalProperties": false
        },
        "structure": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "needs_input",
                "stale"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "notes"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "needs_input",
                "stale"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "notes"
          ],
          "additionalProperties": false
        },
        "facilitation": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "needs_input",
                "stale"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "notes"
          ],
          "additionalProperties": false
        },
        "presentation": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "needs_input",
                "stale"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "notes"
          ],
          "additionalProperties": false
        },
        "review": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "needs_input",
                "stale"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "status",
            "notes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "intake",
        "structure",
        "content",
        "facilitation",
        "presentation",
        "review"
      ],
      "additionalProperties": false
    },
    "delivery": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "draft",
            "needs_input",
            "ready"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "live_presentation",
                  "pptx",
                  "google_slides",
                  "pdf",
                  "lecturer_notes",
                  "timing_table"
                ]
              },
              "location": {
                "type": "string",
                "minLength": 1
              },
              "slide_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "kind",
              "location",
              "slide_ids"
            ],
            "additionalProperties": false
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "artifacts",
        "assumptions",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "lesson_id",
    "mode",
    "scope",
    "brief",
    "sources",
    "questions",
    "duration",
    "explicit_slide_count",
    "chapters",
    "slides",
    "stages",
    "delivery"
  ],
  "additionalProperties": false
}
